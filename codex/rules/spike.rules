# codex/rules/spike.rules

# Block destructive filesystem operations
prefix_rule(
  pattern=["rm"],
  decision="forbidden",
  justification="Deletion is not allowed.",
)

prefix_rule(
  pattern=["mv"],
  decision="forbidden",
  justification="Renaming/moving files is not allowed.",
)

# Block git
prefix_rule(
  pattern=["git"],
  decision="forbidden",
  justification="Git commands are not allowed.",
)

# Block package managers
prefix_rule(
  pattern=["npm"],
  decision="forbidden",
  justification="No npm installs.",
)

prefix_rule(
  pattern=["npx"],
  decision="forbidden",
  justification="No npx.",
)

prefix_rule(
  pattern=["yarn"],
  decision="forbidden",
  justification="No yarn.",
)

prefix_rule(
  pattern=["pnpm"],
  decision="forbidden",
  justification="No pnpm.",
)

# Block system-level operations
prefix_rule(
  pattern=["sudo"],
  decision="forbidden",
  justification="No privilege escalation.",
)

prefix_rule(
  pattern=["brew"],
  decision="forbidden",
  justification="No system package manager.",
)

prefix_rule(
  pattern=["apt"],
  decision="forbidden",
  justification="No system package manager.",
)

# Allow node, but require approval
prefix_rule(
  pattern=["node"],
  decision="prompt",
  justification="Only allow node generate_data.js after approval.",
)
